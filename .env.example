# Скопируйте этот файл в .env и заполните

# Ваш бесплатный статический домен ngrok (без https://)
NGROK_DOMAIN=your-name.ngrok-free.app
NGROK_AUTHTOKEN=

# Имя Matrix-сервера = тот же домен. Менять потом нельзя!
SERVER_NAME=your-name.ngrok-free.app

# Токен администратора Synapse (этап 4)
SYNAPSE_ADMIN_TOKEN=

# true = можно подтверждать номер без WhatsApp (для проверки). На демонстрации поставьте false
DEV_MODE=true

# --- WhatsApp (этап 7) ---
# Номер, на который пользователи отправляют код (только цифры, например 15551234567)
WA_BUSINESS_NUMBER=
# Любая придуманная вами строка, её же вписываете в настройках webhook у Meta
WA_VERIFY_TOKEN=pridumaite-svoyu-stroku
# App Secret из настроек приложения Meta (для проверки подписи webhook)
WA_APP_SECRET=
# Необязательно: чтобы бот отвечал "Номер подтверждён"
WA_ACCESS_TOKEN=
WA_PHONE_NUMBER_ID=
GRAPH_VERSION=v22.0
